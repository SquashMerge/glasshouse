{
  "name": "@astraea/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "test": "bun test",
    "test:unit": "bun test tests/unit --path-ignore-patterns='**/traces-query.test.ts' && bun test tests/unit/traces-query.test.ts",
    "test:integration": "bun test tests/integration",
    "test:clickhouse": "bun test tests/integration/clickhouse-schema.test.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:migrate": "node-pg-migrate up --migrations-dir ../../infra/db/migrations --migration-file-language sql && bun run src/db/bootstrap-authorization.ts",
    "ch:migrate": "bun run src/db/clickhouse-migrate.ts",
    "openapi:snapshot": "bun run ../../infra/codegen/snapshot.ts",
    "codegen:ts": "bun x --bun --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 openapi-typescript ../../openapi.yaml --output ../../clients/ts/api.d.ts --enum --immutable --empty-objects false",
    "codegen:py": "cd ../.. && mkdir -p clients && uvx --from openapi-python-client==0.29.0 openapi-python-client generate --path openapi.yaml --config infra/codegen/openapi-python-client.config.yaml --output-path clients/python --overwrite --no-fail-on-warning"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "@hono/zod-openapi": "1.5.1",
    "@scalar/hono-api-reference": "0.11.11",
    "config": "5.0.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0",
    "hono": "4.12.32",
    "ioredis": "6.0.0",
    "js-yaml": "5.2.3",
    "mustache": "4.2.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "unicode-confusables": "0.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/pg": "8.20.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "node-pg-migrate"
  ]
}
