{
  "name": "@astraea/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:migrate": "node-pg-migrate up",
    "openapi:snapshot": "bun run ../../infra/codegen/snapshot.ts",
    "codegen:ts": "openapi-typescript ../../openapi.yaml --output ../../clients/ts/api.d.ts --enum --immutable --empty-objects false",
    "codegen:py": "cd ../.. && openapi-python-client generate --path openapi.yaml --config-path infra/codegen/openapi-python-client.config.yaml"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "@hono/zod-openapi": "1.5.1",
    "@scalar/hono-api-reference": "0.11.11",
    "hono": "4.12.31",
    "ioredis": "5.11.1",
    "js-yaml": "5.2.1",
    "node-pg-migrate": "9.0.0",
    "openapi-fetch": "0.17.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "node-pg-migrate"
  ]
}