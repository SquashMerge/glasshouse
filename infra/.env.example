# Astraea local dev env defaults.
# COPY this file to infra/.env (gitignored) and edit the secret values before `make dev`.
# `make doctor` will refuse to start with these defaults — you must edit .env first.

# Runtime
NODE_ENV=development

# Backend / frontend ports
API_PORT=3000
WEB_PORT=5173

# Postgres
POSTGRES_USER=astraea
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=astraea
POSTGRES_PORT=5432

# ClickHouse (pinned image platform: linux/amd64 per R-G)
CLICKHOUSE_DB=astraea
CLICKHOUSE_USER=astraea
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Valkey (open-source Redis fork; wire-compatible with ioredis)
VALKEY_PASSWORD=CHANGE_ME
VALKEY_PORT=6379

# Fully-qualified URLs (override the per-component fallbacks in the db
# clients). For local dev (api runs on host), these resolve to localhost.
# For docker compose, the api/web services build these URLs from the per-
# component vars above automatically.
DATABASE_URL=postgres://astraea:CHANGE_ME@localhost:5432/astraea
CLICKHOUSE_URL=http://localhost:8123
VALKEY_URL=redis://:CHANGE_ME@localhost:6379