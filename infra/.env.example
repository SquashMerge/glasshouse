# Astraea local dev env defaults.
# COPY this file to infra/.env (gitignored) and edit the secret values before `make dev`.
# `make doctor` will refuse to start with these defaults — you must edit .env first.

# Runtime
NODE_ENV=development

# Backend / frontend ports
API_PORT=3000
LOG_LEVEL=info
WEB_PORT=5173

# Postgres
POSTGRES_USER=astraea
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=astraea
POSTGRES_PORT=5432

# ClickHouse (pinned image platform: linux/amd64 per R-G)
CLICKHOUSE_DB=astraea
CLICKHOUSE_USER=astraea
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Valkey (open-source Redis fork; wire-compatible with ioredis)
VALKEY_PASSWORD=CHANGE_ME
VALKEY_PORT=6379

# Fully-qualified URLs (override the per-component fallbacks in the db
# clients). For local dev (api runs on host), these resolve to localhost.
# For docker compose, the api/web services build these URLs from the per-
# component vars above automatically.
DATABASE_URL=postgres://astraea:CHANGE_ME@localhost:5432/astraea
CLICKHOUSE_URL=http://localhost:8123
VALKEY_URL=redis://:CHANGE_ME@localhost:6379

# Web / API authentication (HTTP Basic Auth). Legacy deployments may keep this
# single credential; it is mapped to the deterministic migrated default org.
# The web dashboard keeps credentials only in the current page session.
UI_USERNAME=astraea
UI_PASSWORD=CHANGE_ME
# For multi-organization deployments, replace the legacy pair with a JSON
# credential list. Each organization_id must exist in the organizations table.
# ASTRAEA_BASIC_AUTH_CREDENTIALS='[{"username":"acme-exporter","password":"CHANGE_ME","organization_id":"00000000-0000-4000-8000-000000000001"}]'
# OTLP uses OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic <base64(user:pass)>.
# To target a non-default project within the authenticated organization, add
# x-astraea-project-id=<project UUID> to the same exporter header list.

# Trace redaction (optional; defaults to off for dev). When on, input_text
# and output_text are replaced with "[REDACTED]" before persistence, and
# the listed keys are stripped from the metadata column.
ASTRAEA_REDACT_INPUT=false
ASTRAEA_REDACT_KEYS=

# API body size limit (default 1 MiB). Raise for high-volume exporters.
API_MAX_BODY_BYTES=1048576

# GEPA prompt optimization (optional; required for real, non-fake optimization)
# Allow only the exact provider/model identifiers users may select in the UI.
GEPA_ALLOWED_MODELS=openai/gpt-4o-mini,openai/gpt-4o
# Provider credentials are consumed only by the isolated GEPA worker. Keep
# these values in infra/.env or your deployment secret store; never commit them.
OPENAI_API_KEY=CHANGE_ME
# ANTHROPIC_API_KEY=CHANGE_ME
# For an OpenAI-compatible LiteLLM proxy, use its base URL and proxy key:
# OPENAI_API_BASE=https://litellm.example.com/v1
# OPENAI_API_KEY=CHANGE_ME

# Development-only local CLI adapter. Run the API directly on the host after
# authenticating the CLI (for example, `codex login`); do not use this in
# Docker or production. The CLI OAuth/subscription stays in its local store.
# GEPA_WORKER_MODE=cli
# ASTRAEA_DEV_LLM_COMMAND='["codex","exec","--model","{model}","-"]'
# ASTRAEA_DEV_LLM_TIMEOUT_SECONDS=60
# ASTRAEA_DEV_LLM_MAX_OUTPUT_BYTES=65536
# Set only for a deliberate local emergency override; cli mode is otherwise
# rejected when NODE_ENV=production.
# ASTRAEA_ALLOW_DEV_LLM_IN_PRODUCTION=true
