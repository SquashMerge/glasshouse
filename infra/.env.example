# Glasshouse local dev env defaults.
# COPY this file to infra/.env (gitignored) and edit the secret values before `make dev`.
# `make doctor` will refuse to start with these defaults — you must edit .env first.

# Runtime
NODE_ENV=development

# Backend / frontend ports
API_PORT=3000
LOG_LEVEL=info
WEB_PORT=5173

# Postgres
POSTGRES_USER=glasshouse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=glasshouse
POSTGRES_PORT=5432

# ClickHouse (pinned image platform: linux/amd64 per R-G)
CLICKHOUSE_DB=glasshouse
CLICKHOUSE_USER=glasshouse
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Valkey (open-source Redis fork; wire-compatible with ioredis)
VALKEY_PASSWORD=CHANGE_ME
VALKEY_PORT=6379

# Optional host-local service URL overrides for `make dev-backend`. Leave these
# unset for the standard local workflow: the API derives localhost URLs from
# the component variables above. `make dev` injects its own Compose service-
# network URLs and does not use these overrides.
# DATABASE_URL=postgres://user:password@host:5432/database
# CLICKHOUSE_URL=http://host:8123
# VALKEY_URL=redis://:password@host:6379

# Web / API authentication (HTTP Basic Auth). Legacy deployments may keep this
# single credential; it is mapped to the deterministic migrated default org.
# The web dashboard keeps credentials only in the current page session.
UI_USERNAME=glasshouse
UI_PASSWORD=CHANGE_ME
# Required before the API accepts traffic after migrations. It must name exactly
# one configured Basic Auth credential and is granted owner/manager bootstrap access.
GLASSHOUSE_BOOTSTRAP_OWNER_USERNAME=glasshouse
# Keep basic for existing installations. local skips the automatic Basic owner
# grant on fresh local-first deployments; it never removes existing authorization.
GLASSHOUSE_AUTH_BOOTSTRAP_MODE=basic
# Server-selected local bootstrap organization; it must already exist.
# GLASSHOUSE_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Operator command only: 32 random bytes as 43-character unpadded base64url.
# bun run --cwd apps/api auth:provision-bootstrap stores a single-use 24-hour digest.
# GLASSHOUSE_LOCAL_BOOTSTRAP_TOKEN_FILE=/run/secrets/glasshouse-local-bootstrap
# Local sessions use HttpOnly cookies, never JS storage. Set the exact browser
# origin when behind a reverse proxy; production requires HTTPS and Secure cookies.
# GLASSHOUSE_PUBLIC_ORIGIN=https://glasshouse.example.com
# See docs/local-credentials-runbook.md. Browser setup/account UI follows in #190.
# For multi-organization deployments, replace the legacy pair with a JSON
# credential list. Each organization_id must exist in the organizations table.
# GLASSHOUSE_BASIC_AUTH_CREDENTIALS='[{"username":"acme-exporter","password":"CHANGE_ME","organization_id":"00000000-0000-4000-8000-000000000001"}]'
# OTLP uses OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic <base64(user:pass)>.
# Every OTLP request must target an authorized active project; add
# x-glasshouse-project-id=<project UUID> to the same exporter header list.

# Trace redaction (optional; defaults to off for dev). When on, input_text
# and output_text are replaced with "[REDACTED]" before persistence, and
# the listed keys are stripped from the metadata column.
GLASSHOUSE_REDACT_INPUT=false
GLASSHOUSE_REDACT_KEYS=

# API body size limit (default 1 MiB). Raise for high-volume exporters.
API_MAX_BODY_BYTES=1048576
# Retained OTLP fields remain bounded independently of request size: text is
# clipped at 8192 UTF-8 bytes, metadata at 16384 bytes, and API/detail pages
# at 262144 encoded bytes. Detail SSE snapshots also obey SSE_MAX_PENDING_BYTES.
# These storage-safe ceilings are not configurable.

# Every authenticated SSE frame holds an authorization fence through delivery.
# Abort a backpressured frame or stalled trace snapshot after this many milliseconds
# (100-60000; default 5000).
SSE_FRAME_WRITE_TIMEOUT_MS=5000
# Close rather than retaining more than this many queued frames or bytes while a
# client is backpressured or a trace snapshot is loading. Count: 1-256 (default 32);
# bytes: 1024-1048576 (default 65536). The active frame counts toward both limits.
SSE_MAX_PENDING_FRAMES=32
SSE_MAX_PENDING_BYTES=65536

# Provider dispatch and trace/metric/result/event writes first commit a logical
# PostgreSQL effect claim. This is not physical atomicity with a remote provider
# or ClickHouse. Bound local cancellation and polling.
# Timeout: 1000-300000 ms (default 30000); poll: 50-5000 ms (default 250).
EXECUTION_ADMISSION_TIMEOUT_MS=30000
EXECUTION_ADMISSION_POLL_MS=250

# Evaluation Run operator envelope. Only exact provider/model identifiers in
# EVALUATION_ALLOWED_MODELS may be admitted; the resolved value and all bounds
# are immutable per Run. Active caps allow 1-32; requested Definition sample-size
# and provider-call caps allow 1-10000. Invalid numeric caps use the safe defaults below; an invalid
# allowlist rejects admission. `make dev` supplies infra/.env to Compose for
# ${...} interpolation, but that alone does not inject every value into a
# service: infra/compose.yaml explicitly forwards this envelope to the API.
# The devcontainer's env_file separately injects infra/.env into workspace.
EVALUATION_ALLOWED_MODELS=openai/gpt-4o-mini
EVALUATION_MAX_ACTIVE_RUNS_PER_PROJECT=4
EVALUATION_MAX_ACTIVE_RUNS_PER_ACTOR=2
EVALUATION_MAX_REQUESTED_SAMPLE_SIZE_PER_RUN=100
EVALUATION_MAX_PROVIDER_CALLS_PER_RUN=100

# GEPA prompt optimization (optional; required for real, non-fake optimization)
# Allow only the exact provider/model identifiers users may select in the UI.
GEPA_ALLOWED_MODELS=openai/gpt-4o-mini,openai/gpt-4o
# Provider credentials are consumed only by the isolated GEPA worker. Keep
# these values in infra/.env or your deployment secret store; never commit them.
# OPENAI_API_KEY=CHANGE_ME
# ANTHROPIC_API_KEY=CHANGE_ME
# For an OpenAI-compatible LiteLLM proxy, use its base URL and proxy key:
# OPENAI_API_BASE=https://litellm.example.com/v1
# OPENAI_API_KEY=CHANGE_ME

# Development-only local CLI adapter. Run the API directly on the host after
# authenticating the CLI (for example, `codex login`); do not use this in
# Docker or production. The CLI OAuth/subscription stays in its local store.
# GEPA_WORKER_MODE=cli
# GLASSHOUSE_DEV_LLM_COMMAND='["codex","exec","--model","{model}","-"]'
# GLASSHOUSE_DEV_LLM_TIMEOUT_SECONDS=60
# GLASSHOUSE_DEV_LLM_MAX_OUTPUT_BYTES=65536
# Set only for a deliberate local emergency override; cli mode is otherwise
# rejected when NODE_ENV=production.
# GLASSHOUSE_ALLOW_DEV_LLM_IN_PRODUCTION=true
