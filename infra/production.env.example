# Production-only Compose environment. Store the real file outside the repo or
# in a secret manager; never commit credentials.
NODE_ENV=production
GLASSHOUSE_PUBLIC_ORIGIN=https://glasshouse.example.com
POSTGRES_USER=glasshouse
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
POSTGRES_DB=glasshouse
CLICKHOUSE_USER=glasshouse
CLICKHOUSE_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
CLICKHOUSE_DB=glasshouse
VALKEY_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
UI_USERNAME=glasshouse
UI_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
GLASSHOUSE_BOOTSTRAP_OWNER_USERNAME=glasshouse
GEPA_ALLOWED_MODELS=openai/gpt-4o-mini
GEPA_WORKER_MODE=gepa

# Deployment redaction floor for newly ingested data (not retroactive).
GLASSHOUSE_REDACT_INPUT=false
GLASSHOUSE_REDACT_KEYS=

# Evaluation admission envelope; models use exact provider/model identities.
EVALUATION_ALLOWED_MODELS=openai/gpt-4o-mini
EVALUATION_MAX_ACTIVE_RUNS_PER_PROJECT=4
EVALUATION_MAX_ACTIVE_RUNS_PER_ACTOR=2
EVALUATION_MAX_REQUESTED_SAMPLE_SIZE_PER_RUN=100
EVALUATION_MAX_PROVIDER_CALLS_PER_RUN=100

# Concurrent active optimization admissions (queued/preparing/optimizing/evaluating).
# Conservative defaults: at most 3 per Project and 1 per requester, max configurable value 1000.
GEPA_MAX_ACTIVE_JOBS_PER_PROJECT=3
GEPA_MAX_ACTIVE_JOBS_PER_REQUESTER=1
OPENAI_API_KEY=replace-or-use-your-secret-manager
