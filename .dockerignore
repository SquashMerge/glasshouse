# SQL inputs live only in the schema and script trees; other SQL may be dumps.
**/*.sql
!infra/db/**/*.sql
!infra/scripts/**/*.sql

# Secrets and local operator configuration, at any depth.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
**/.npmrc
**/.pypirc
**/auth.json
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/secrets
**/.secrets
**/.ssh
**/.aws
**/.config
**/.codex

# Backups and dumps; keep infra/db SQL migrations and ClickHouse backup.xml.
**/backups
**/backup
**/dumps
**/dump
**/*.dump
**/*.backup
**/*.bak
**/*.old
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*.tar
**/*.tar.*
**/*.tgz
**/*.zip
**/*.7z
**/*.sqlite
**/*.sqlite3
**/*.rdb
**/*.aof
.ci-backup-restore

# Checkout metadata, local tools, dependencies and generated artifacts.
**/.git
.github
.devcontainer
.opencode
**/.idea
**/.vscode
**/node_modules
**/.venv
**/.venv-*
**/.venv.*
**/venv
**/env
**/__pycache__
**/*.pyc
**/.cache
**/.npm
**/.bun
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.vite
**/dist
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/*.log
**/*.tmp
**/*.swp
**/.DS_Store
