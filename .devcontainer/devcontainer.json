{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Astraea",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/astraea",
  "remoteUser": "bun",
  "updateRemoteUserUID": true,
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Astraea API"
    }
  },
  "containerEnv": {
    "POSTGRES_HOST": "postgres",
    "POSTGRES_PORT": "5432",
    "CLICKHOUSE_HOST": "clickhouse",
    "CLICKHOUSE_HTTP_PORT": "8123",
    "VALKEY_HOST": "valkey",
    "VALKEY_PORT": "6379",
    "GEPA_PYTHON": "${containerWorkspaceFolder}/.venv-gepa/bin/python"
  },
  "postCreateCommand": "bun install --frozen-lockfile && python3 -m venv .venv-gepa && .venv-gepa/bin/pip install --no-cache-dir -r worker/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "ms-python.python",
        "ms-playwright.playwright"
      ]
    }
  }
}
