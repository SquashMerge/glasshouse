{
  "name": "glasshouse",
  "version": "0.1.0",
  "private": true,
  "description": "Glasshouse",
  "license": "BUSL-1.1",
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "make dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun run test:pg-migration-filenames && bun --filter @glasshouse/api test:unit && bun --filter @glasshouse/web test",
    "test:pg-migration-filenames": "bun test ./infra/scripts/tests/verify-pg-migration-filenames.test.ts ./infra/scripts/tests/pg-migration-order-mode.test.ts",
    "smoke": "make smoke",
    "doctor": "make doctor",
    "openapi:snapshot": "bun --filter @glasshouse/api openapi:snapshot",
    "openapi:check": "bun --filter @glasshouse/api openapi:check",
    "codegen": "bun run openapi:snapshot && bun --filter @glasshouse/api codegen:ts && bun --filter @glasshouse/api codegen:py",
    "format": "bun --filter '*' format",
    "format:check": "bun --filter '*' format:check",
    "test:supply-chain": "bun test infra/scripts/tests/verify-dependency-release-age.test.ts infra/scripts/tests/verify-startup-migrations-ci.test.ts infra/scripts/tests/verify-migration-locks.test.ts",
    "test:infra-security": "bun test infra/scripts/tests/production-compose.test.ts infra/scripts/tests/worker-install.test.ts infra/scripts/tests/datastore-versions.test.ts && python3 -m unittest discover -s infra/scripts/tests -p 'test_*.py'",
    "verify:dependency-release-age": "bun run infra/scripts/verify-dependency-release-age.ts"
  },
  "overrides": {
    "brace-expansion": "5.0.11",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "zod": "4.6.6"
  },
  "dependencies": {
    "config": "5.0.1",
    "dotenv": "18.0.9",
    "dotenv-expand": "1000.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "js-yaml": "5.5.0",
    "typescript": "7.0.2"
  }
}
