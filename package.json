{
  "name": "astraea",
  "version": "0.1.0",
  "private": true,
  "description": "Astraea",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "make dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter @astraea/api test:unit && bun --filter @astraea/web test",
    "smoke": "make smoke",
    "doctor": "make doctor",
    "codegen": "make codegen",
    "format": "bun --filter '*' format"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}