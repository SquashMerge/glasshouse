{
  "name": "astraea",
  "version": "0.1.0",
  "private": true,
  "description": "Astraea",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "make dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter @astraea/api test:unit && bun --filter @astraea/web test",
    "smoke": "make smoke",
    "doctor": "make doctor",
    "codegen": "make codegen",
    "format": "bun --filter '*' format",
    "format:check": "bun --filter '*' format:check"
  },
  "dependencies": {
    "config": "3.3.12",
    "dotenv": "16.6.1",
    "dotenv-expand": "12.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
    "js-yaml": "5.2.2",
    "typescript": "7.0.2"
  }
}
