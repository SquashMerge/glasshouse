{
  "name": "astraea",
  "version": "0.1.0",
  "private": true,
  "description": "Astraea",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "make dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter @astraea/api test:unit && bun --filter @astraea/web test",
    "smoke": "make smoke",
    "doctor": "make doctor",
    "openapi:snapshot": "bun --filter @astraea/api openapi:snapshot",
    "codegen": "bun run openapi:snapshot && bun --filter @astraea/api codegen:ts && bun --filter @astraea/api codegen:py",
    "format": "bun --filter '*' format",
    "format:check": "bun --filter '*' format:check",
    "test:supply-chain": "bun test infra/scripts/tests/verify-dependency-release-age.test.ts",
    "verify:dependency-release-age": "bun run infra/scripts/verify-dependency-release-age.ts"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "dependencies": {
    "config": "4.4.2",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "js-yaml": "5.2.2",
    "typescript": "7.0.2"
  }
}
